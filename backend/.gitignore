# Ignore everything
*

# Ignore all environment files
**/.env
**/.env.*

# Allow root files
!.gitignore
!.envexample
!drizzle.config.ts
!package-lock.json
!package.json
!tsconfig.json

# Allow src directory
!src/
src/*

# Allow config
!src/config/
src/config/*
!src/config/cloudinary.ts
!src/config/db.ts
!src/config/schema.ts

# Allow middleware
!src/config/middleware/
!src/config/middleware/**

# Allow controllers
!src/controllers/
src/controllers/*
!src/controllers/users/
!src/controllers/users/**
!src/controllers/artist/
!src/controllers/artist/**
!src/controllers/auth/
!src/controllers/auth/**

# Allow routes
!src/routes/
src/routes/*
!src/routes/users/
!src/routes/users/**
!src/routes/artist/
!src/routes/artist/**
