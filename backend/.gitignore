
# Ignore everything
*

# Allow root files
!.gitignore
!drizzle.config.ts
!package-lock.json
!package.json
!tsconfig.json

# Allow src directory
!src/

# Allow config directory
!src/config/
!src/config/cloudinary.ts
!src/config/db.ts
!src/config/schema.ts

# Allow middleware directory and its contents
!src/config/middleware/
!src/config/middleware/**

# Allow controllers directory
!src/controllers/
!src/controllers/auth/
!src/controllers/auth/**
